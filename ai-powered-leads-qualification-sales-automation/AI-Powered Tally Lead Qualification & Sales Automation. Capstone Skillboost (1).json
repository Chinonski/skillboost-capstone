    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n  \n  const cleanData = {\n    submissionId: data.id,\n    formName: data.formName,\n    submittedAt: data.createdAt\n  };\n\n  for (const [key, field] of Object.entries(data)) {\n    if (field && typeof field === 'object' && 'label' in field && 'value' in field) {\n      let answer = field.value;\n\n      // If the question has selectable options (dropdowns/checkboxes), map IDs to their readable text\n      if (Array.isArray(field.options) && Array.isArray(answer)) {\n        answer = answer.map(id => {\n          const matchedOption = field.options.find(opt => opt.id === id);\n          return matchedOption ? matchedOption.text : id;\n        }).join(', ');\n      }\n\n      cleanData[field.label] = answer;\n    }\n  }\n\n  results.push({ json: cleanData });\n}\n\nreturn results;"
      },
